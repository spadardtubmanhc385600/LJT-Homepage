{
  "name": "LJT-Homepage",
  "version": "0.8.1.1",
  "description": "Junteng Liu's academic homepage built on the Academic Pages Jekyll theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/spadardtubmanhc385600/LJT-Homepage"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spadardtubmanhc385600/LJT-Homepage/issues"
  },
  "homepage": "https://github.com/spadardtubmanhc385600/LJT-Homepage",
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"    
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
